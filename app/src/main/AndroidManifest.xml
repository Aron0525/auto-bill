<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 无障碍服务：核心采集通道 -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
    <!-- 发测试通知（Android 13+ 需要 POST_NOTIFICATIONS） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 远程更新：拉取版本描述 + 下载 APK（仅此用途；ML Kit 识别完全离线） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 远程更新：安装下载好的 APK（Android 8+ 按应用授权） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 更新服务器可能是局域网 http（自建），本应用没有其他联网行为，放行明文 -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.AutoBill">

        <activity android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 设置 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.AutoBill"
            android:windowSoftInputMode="adjustResize" />

        <!-- 待确认队列：机器拿不准的交易摆给用户看，不再静默丢弃 -->
        <activity
            android:name=".PendingActivity"
            android:exported="false"
            android:theme="@style/Theme.AutoBill"
            android:windowSoftInputMode="adjustResize" />

        <!-- 应用读屏权限：逐个 App 控制是否读屏（解决刷商品页被误记） -->
        <activity
            android:name=".AppScreenActivity"
            android:exported="false"
            android:theme="@style/Theme.AutoBill"
            android:windowSoftInputMode="adjustResize" />

        <!-- 端到端自检：adb 广播注入文本，走真实落账管道 -->
        <receiver
            android:name=".TestPipeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.aron.autobill.TEST_PIPE" />
            </intent-filter>
        </receiver>

        <!-- 记一笔（全屏） -->
        <activity
            android:name=".AddBillActivity"
            android:exported="false"
            android:theme="@style/Theme.AutoBill"
            android:windowSoftInputMode="adjustResize" />

        <!-- 截图记账：接收其他应用分享来的图片
             singleTop：已在前台再分享时复用实例走 onNewIntent，不叠新实例 -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="截图记账"
            android:theme="@style/Theme.AutoBill"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- 无障碍服务：读取通知文本 + 抓支付页 -->
        <service
            android:name=".AutoBillAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 通知监听服务：自动记账的**主数据源**。
             相比无障碍通知事件，这里能拿到完整 Notification 对象、
             EXTRA_BIG_TEXT 全文、通知历史，且 MIUI 上稳定得多。
             需要用户在「通知使用权」里手动授权（见设置页引导）。 -->
        <service
            android:name=".BillNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 自检：触发一条记账横幅通知，验证通知链路。
             exported=true 仅为便于 adb 调试；它只发一条固定演示通知，不读不传任何数据。 -->
        <receiver
            android:name=".MainActivity$TestNotifyReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.aron.autobill.TEST_NOTIFY" />
            </intent-filter>
        </receiver>

        <!-- 远程更新：向系统安装器分享下载好的 APK（仅 update/ 目录可被分享） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.aron.autobill.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>